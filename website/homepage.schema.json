{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LetA-Tech/mellions-coxen/blob/main/website/homepage.schema.json",
  "title": "Mellions Coxen homepage content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "locales"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shortName",
        "definition",
        "canonicalUrl",
        "repositoryUrl",
        "sourcePath",
        "links"
      ],
      "properties": {
        "name": { "const": "Mellions Coxen" },
        "shortName": { "const": "Mellions" },
        "definition": {
          "const": "Engineering responsibility and reliability for frontier coding agents."
        },
        "canonicalUrl": { "const": "https://letatech.ca/mellions-coxen" },
        "repositoryUrl": {
          "const": "https://github.com/LetA-Tech/mellions-coxen"
        },
        "sourcePath": { "const": "website/homepage.json" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "documentation",
            "installation",
            "integrations",
            "benchmarks",
            "releases",
            "issues",
            "contributing"
          ],
          "properties": {
            "repository": {
              "const": "https://github.com/LetA-Tech/mellions-coxen"
            },
            "documentation": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/blob/main/docs/README.md"
            },
            "installation": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/blob/main/docs/install.md"
            },
            "integrations": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/blob/main/docs/integrations.md"
            },
            "benchmarks": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/blob/main/docs/benchmarks.md"
            },
            "releases": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/releases"
            },
            "issues": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/issues"
            },
            "contributing": {
              "const": "https://github.com/LetA-Tech/mellions-coxen/blob/main/CONTRIBUTING.md"
            }
          }
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fr"],
      "properties": {
        "en": { "$ref": "#/$defs/locale" },
        "fr": { "$ref": "#/$defs/locale" }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "title", "description"],
      "properties": {
        "label": { "type": "string", "pattern": "^[0-9]{2}$" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmpty" },
        "target": { "enum": ["benchmarks", "repository", "releases"] }
      }
    },
    "supportItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "status", "description", "icon", "target"],
      "properties": {
        "name": { "enum": ["Claude Code", "Codex", "GitHub"] },
        "kind": { "$ref": "#/$defs/nonEmpty" },
        "status": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "icon": { "enum": ["claude-code", "codex", "github"] },
        "target": { "enum": ["integrations", "repository"] }
      }
    },
    "comparisonRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "without", "with"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmpty" },
        "without": { "$ref": "#/$defs/nonEmpty" },
        "with": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "target"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "target": {
          "enum": ["documentation", "releases", "issues", "contributing"]
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation",
        "metadata",
        "hero",
        "why",
        "model",
        "evidence",
        "support",
        "install",
        "closing"
      ],
      "properties": {
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "overview",
            "challenge",
            "model",
            "integrations",
            "evidence",
            "install",
            "community"
          ],
          "properties": {
            "label": { "$ref": "#/$defs/nonEmpty" },
            "overview": { "$ref": "#/$defs/nonEmpty" },
            "challenge": { "$ref": "#/$defs/nonEmpty" },
            "model": { "$ref": "#/$defs/nonEmpty" },
            "integrations": { "$ref": "#/$defs/nonEmpty" },
            "evidence": { "$ref": "#/$defs/nonEmpty" },
            "install": { "$ref": "#/$defs/nonEmpty" },
            "community": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description"],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eyebrow",
            "title",
            "description",
            "primaryCta",
            "secondaryCta",
            "integrationLabel"
          ],
          "properties": {
            "eyebrow": { "$ref": "#/$defs/nonEmpty" },
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "primaryCta": { "$ref": "#/$defs/nonEmpty" },
            "secondaryCta": { "$ref": "#/$defs/nonEmpty" },
            "integrationLabel": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "why": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "illustrationAlt", "points"],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "illustrationAlt": { "$ref": "#/$defs/nonEmpty" },
            "points": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/card" }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "steps"],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "steps": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/step" }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "comparison", "links"],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "comparison": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headers", "rows"],
              "properties": {
                "headers": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["capability", "without", "with"],
                  "properties": {
                    "capability": { "$ref": "#/$defs/nonEmpty" },
                    "without": { "$ref": "#/$defs/nonEmpty" },
                    "with": { "$ref": "#/$defs/nonEmpty" }
                  }
                },
                "rows": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": { "$ref": "#/$defs/comparisonRow" }
                }
              }
            },
            "links": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/evidenceLink" }
            }
          }
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "items", "linkLabel"],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/supportItem" }
            },
            "linkLabel": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "command",
            "availability",
            "note",
            "linkLabel",
            "copyLabel",
            "copiedLabel",
            "copyFailedLabel"
          ],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "command": {
              "type": "string",
              "pattern": "git clone https://github\\.com/LetA-Tech/mellions-coxen\\.git"
            },
            "availability": { "$ref": "#/$defs/nonEmpty" },
            "note": { "$ref": "#/$defs/nonEmpty" },
            "linkLabel": { "$ref": "#/$defs/nonEmpty" },
            "copyLabel": { "$ref": "#/$defs/nonEmpty" },
            "copiedLabel": { "$ref": "#/$defs/nonEmpty" },
            "copyFailedLabel": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "closing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "primaryCta",
            "secondaryCta",
            "resources"
          ],
          "properties": {
            "title": { "$ref": "#/$defs/nonEmpty" },
            "description": { "$ref": "#/$defs/nonEmpty" },
            "primaryCta": { "$ref": "#/$defs/nonEmpty" },
            "secondaryCta": { "$ref": "#/$defs/nonEmpty" },
            "resources": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/resource" }
            }
          }
        }
      }
    }
  }
}
